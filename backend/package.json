{
  "name": "spherecho-portal-api",
  "version": "1.0.0",
  "private": true,
  "description": "Backend for the Spherecho internal & partner portal",
  "main": "src/index.js",
  "scripts": {
    "sync-shared": "node scripts/sync-shared.js",
    "prebuild": "npm run sync-shared",
    "build": "sam build",
    "deploy": "npm run sync-shared && sam build && sam deploy --guided",
    "local": "npm run sync-shared && node local/server.js",
    "test": "npm run sync-shared && node test/api.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.700.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "aws-jwt-verify": "^4.0.1"
  },
  "engines": { "node": ">=20" }
}
